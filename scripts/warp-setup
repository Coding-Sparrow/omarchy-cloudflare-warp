#!/bin/bash
# Helper for the Cloudflare WARP Omarchy plugin.
#
#   warp-setup state              JSON status, as the panel reads it
#   warp-setup install            install cloudflare-warp-bin and start warp-svc (interactive, sudo)
#   warp-setup start-service      enable and start warp-svc (interactive, sudo)
#   warp-setup register [team]    join a Zero Trust team, or free WARP when empty
#   warp-setup unregister         delete this device's registration
#   warp-setup connect|disconnect

set -u
PKG="cloudflare-warp-bin"
WARP=(warp-cli --accept-tos)
DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

cmd_start_service() {
  echo "Starting the WARP service (warp-svc)..."
  sudo systemctl enable --now warp-svc.service || return 1
  for _ in {1..15}; do
    "${WARP[@]}" status >/dev/null 2>&1 && break
    sleep 1
  done

  # The bar panel replaces Cloudflare's tray app, whose icon hides in the tray
  # drawer under a fresh id every launch.
  systemctl --user disable --now warp-taskbar.service 2>/dev/null || true

  echo "WARP is running. Open the WARP panel in the bar to sign in."
}

cmd_install() {
  echo "Installing Cloudflare WARP ($PKG)..."
  omarchy-pkg-aur-add "$PKG" || { echo "Installation failed."; return 1; }
  cmd_start_service
}

cmd_register() {
  local team="${1:-}"
  "${WARP[@]}" registration delete >/dev/null 2>&1
  if [[ -n $team ]]; then
    "${WARP[@]}" registration new "$team"
  else
    "${WARP[@]}" registration new && "${WARP[@]}" connect
  fi
}

case "${1:-}" in
  state) exec "$DIR/state.sh" ;;
  install) cmd_install ;;
  start-service) cmd_start_service ;;
  register) shift; cmd_register "${1:-}" ;;
  unregister) "${WARP[@]}" disconnect >/dev/null 2>&1; "${WARP[@]}" registration delete ;;
  connect) "${WARP[@]}" connect ;;
  disconnect) "${WARP[@]}" disconnect ;;
  *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
